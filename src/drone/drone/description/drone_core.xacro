<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nidar_drone">
    
    <!-- Core Properties -->
    <!-- Target AUW: 2.5 kg. Distributed as 2.0 kg body + 4x 0.125 kg rotors -->
    <xacro:property name = "body_mass" value = "2.0"/>
    <xacro:property name = "rotor_mass" value = "0.125"/>
    <!-- 10 inch propeller diameter = 0.254 meters -->
    <xacro:property name="prop_radius" value="${0.254 / 2}"/>
    <xacro:property name="arm_length" value="0.22"/>

    <!-- Base Link Chassis--> 
     <link name = 'base_link'>
        <inertial>
            <mass value = "${body_mass}"/>
            <origin xyz = '0 0 0' rpy = '0 0 0'/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
        </inertial>
        
        <visual>
            <geometry>
                <box size = '0.2 0.2 0.1'/>
            </geometry>
            <material name = 'dark_grey'>
                <color rgba='0.2 0.2 0.2 1.0'/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size = '0.2 0.2 0.1'/>
            </geometry>
        </collision>
     </link>

    <!--Rotor Macro-->
    <xacro:macro name="rotor" params="prefix x_reflect y_reflect">
    <link name="${prefix}_rotor">
      <inertial>
        <mass value="${rotor_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="${prop_radius}" length="0.01"/>
        </geometry>
        <material name="red">
          <color rgba="0.8 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${prop_radius}" length="0.01"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_rotor_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_rotor"/>
      <origin xyz="${x_reflect * arm_length} ${y_reflect * arm_length} 0.06" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

    <!-- Instantiate Quadcopter Rotors -->
  <xacro:rotor prefix="front_right" x_reflect="1" y_reflect="-1" />
  <xacro:rotor prefix="front_left" x_reflect="1" y_reflect="1" />
  <xacro:rotor prefix="rear_right" x_reflect="-1" y_reflect="-1" />
  <xacro:rotor prefix="rear_left" x_reflect="-1" y_reflect="1" />
</robot>